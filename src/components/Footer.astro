---
import { base, withBase } from "../lib/base";

const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/#film", label: "Le film" },
  { href: "/#campagne", label: "La campagne" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="footer">
  <div class="container grid">
    <div class="col">
      <img class="logo" src={`${base}/images/logo-6-12-white.svg`} alt="Agence 6-12" />
      <ul class="coords">
        <li>Agence 6-12 — 109 boulevard Beaumarchais, 75003 Paris</li>
        <li>[Téléphone à venir]</li>
        <li>contact@agence6-12.fr</li>
      </ul>

      <ul class="social">
        <li>
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </li>
        <li>
          <a href="#" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <line x1="7.5" y1="10.5" x2="7.5" y2="16.5" />
              <circle cx="7.5" cy="7.2" r="0.9" fill="currentColor" stroke="none" />
              <path d="M11.5 16.5v-4c0-1.4 1-2.4 2.2-2.4s2.1 1 2.1 2.4v4" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <div class="col">
      <p class="col-title">Navigation</p>
      <ul class="links">
        {navLinks.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="col">
      <p class="col-title">Nos autres films</p>
      <ul class="links">
        <li>Film 1</li>
        <li>Film 2</li>
        <li>Film 3</li>
        <li>Film 4</li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>Heartbreak / Memoria — {new Date().getFullYear()}</p>
    <ul class="legal">
      <li><a href="#">Copyright</a></li>
      <li><a href={withBase("/mentions-legales")}>Mentions légales</a></li>
      <li><a href={withBase("/cgv")}>CGV</a></li>
      <li><a href="https://blob.blue" target="_blank" rel="noopener">Agence blob.blue</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    color: var(--white);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .logo {
    height: 110px;
    width: auto;
    margin: 0 0 1.5rem;
  }

  .coords {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--grey);
    font-size: 0.9rem;
  }

  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(250, 250, 248, 0.3);
    border-radius: 50%;
    color: var(--white);
  }

  .social a:hover {
    border-color: var(--white);
    color: var(--grey);
  }

  .social svg {
    width: 16px;
    height: 16px;
  }

  .col-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--grey);
    margin: 0 0 1.25rem;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .links a {
    color: var(--white);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .links a:hover {
    color: var(--grey);
  }

  .links li {
    font-size: 0.9rem;
    color: var(--grey);
  }

  .bottom {
    border-top: 1px solid rgba(250, 250, 248, 0.15);
    padding-block: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .bottom p {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--grey);
  }

  .legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .legal a {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--grey);
  }

  .legal a:hover {
    color: var(--white);
  }
</style>
