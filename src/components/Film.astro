---
import { base, withBase } from "../lib/base";

const galleryImages = [
  { src: "/images/film-image1.jpeg", caption: "Le dispositif du masque, référence aux tragédies grecques antiques" },
  { src: "/images/film-image2.jpeg", caption: "Rencontre publique autour du personnage, à Tel-Aviv" },
  { src: "/images/film-image3.jpeg", caption: "Un tournage au plus près de la société qu'il traverse" },
];

const meta = [
  { label: "Année", value: "2025" },
  { label: "Durée", value: "47 min" },
  { label: "Langue", value: "Hébreu, Français, Anglais" },
  { label: "De", value: "Jessica Vaturi-Dembo" },
  { label: "Avec", value: "Asher Zelmati, Mor Birger, Idan Kogan, Serah Zelmati" },
  { label: "Production", value: "Vito Films & Métabole & Cie" },
];
---

<section class="film" id="film">
  <div class="container">
    <div class="synopsis-row">
      <div class="synopsis-col">
        <p class="eyebrow">Le film</p>
        <h2 class="display title">HEARTBREAK</h2>
        <p class="synopsis-label">Synopsis</p>
        <p class="synopsis">
          Heartbreak est le nom d'un personnage du silence, espiègle et
          poétique, confronté à la violence extrême. Survivant d'une attaque
          terroriste qui a mué en guerre, Heartbreak, mime et danseur, va de
          lieu en lieu, à l'écoute des autres. Inspiré par Buster Keaton et
          Marcel Marceau, ce film hybride est une fiction muette en noir et
          blanc, percutée par le réel.
        </p>

        <dl class="meta-list">
          {
            meta.map((m) => (
              <div class="meta-row">
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>

        <h3 class="subhead" id="trailer">Bande annonce</h3>
        <div class="trailer">
          <iframe
            src="https://www.youtube-nocookie.com/embed/Ww0fs7y43Nw"
            title="Bande-annonce — Heartbreak"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <div class="poster">
        <img src={`${base}/images/heartbreak-poster.png`} alt="Affiche officielle du film Heartbreak" />
        <a class="cta poster-cta" href={withBase("/contact")}>Kit presse</a>
      </div>
    </div>

    <h3 class="subhead">Images du film</h3>
    <div class="gallery">
      {
        galleryImages.map((img, i) => (
          <figure class="gallery-item photo">
            <img src={`${base}${img.src}`} alt={`Photo du film Heartbreak ${i + 1}`} />
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .film {
    padding-block: clamp(4rem, 10vh, 7rem);
    border-bottom: 1px solid var(--line);
  }

  .title {
    font-size: 3rem;
    margin-block: 0.5rem 2.5rem;
  }

  .trailer {
    aspect-ratio: 16 / 9;
    max-width: 560px;
    margin-bottom: 2.5rem;
    border: 1px solid var(--line);
  }

  .trailer iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .synopsis-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 700px) {
    .synopsis-row {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }

    .synopsis-col {
      grid-column: 1 / 8;
    }

    .poster {
      grid-column: 9 / 13;
    }
  }

  .poster {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 120px;
  }

  .poster img {
    width: 100%;
    border: 1px solid var(--line);
    filter: grayscale(1);
  }

  .poster-cta {
    align-self: flex-start;
  }

  .synopsis-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--black);
    margin: 0 0 0.75rem;
  }

  .synopsis {
    max-width: 65ch;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 1.75rem;
  }

  .meta-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    max-width: 100%;
    margin: 0;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.4rem;
    border-top: 1px solid var(--line);
  }

  .meta-row dt {
    color: var(--grey);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .meta-row dd {
    margin: 0;
    font-size: 0.85rem;
    text-align: right;
  }

  #trailer.subhead {
    margin-top: 72px;
  }

  .subhead {
    font-family: var(--body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    color: var(--black);
    margin: 3rem 0 1.25rem;
  }

  .cta {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1rem 1.75rem;
    background: var(--black);
    color: var(--white);
  }


  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }


  .gallery-item {
    margin: 0;
    border: 1px solid var(--line);
  }

  .gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(1);
  }

  .gallery-item figcaption {
    padding: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--grey);
  }
</style>
