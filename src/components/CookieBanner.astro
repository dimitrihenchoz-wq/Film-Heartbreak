<div class="cookie-banner" id="cookie-banner" hidden>
  <div class="container inner">
    <p>
      Ce site utilise des cookies pour améliorer votre expérience et
      mesurer l'audience. Vous pouvez accepter ou refuser leur utilisation.
    </p>
    <div class="actions">
      <button class="btn ghost" id="cookie-refuse">Refuser</button>
      <button class="btn" id="cookie-accept">Accepter</button>
    </div>
  </div>
</div>

<script>
  const KEY = "heartbreak-cookie-consent";
  const banner = document.querySelector<HTMLDivElement>("#cookie-banner");

  if (banner) {
    try {
      if (!localStorage.getItem(KEY)) {
        banner.hidden = false;
      }
    } catch {
      banner.hidden = false;
    }
  }

  const setConsent = (value: string) => {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      // ignore storage errors (private browsing, etc.)
    }
    if (banner) banner.hidden = true;
  };

  document.querySelector("#cookie-accept")?.addEventListener("click", () => setConsent("accepted"));
  document.querySelector("#cookie-refuse")?.addEventListener("click", () => setConsent("refused"));
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    background: var(--black);
    color: var(--white);
    border-top: 1px solid rgba(250, 250, 248, 0.2);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }

  p {
    margin: 0;
    max-width: 60ch;
    font-size: 0.85rem;
    color: var(--grey);
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn {
    font-family: var(--body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    background: var(--white);
    color: var(--black);
    border: 1px solid var(--white);
    cursor: pointer;
  }

  .btn.ghost {
    background: transparent;
    color: var(--white);
  }
</style>
